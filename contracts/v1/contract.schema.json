{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2qtech.github.io/shenk/contracts/v1/contract.schema.json",
  "title": "Shenk shared data contract v1",
  "type": "object",
  "required": ["contractVersion"],
  "properties": {
    "contractVersion": { "const": "1.0" }
  },
  "$defs": {
    "entity": {
      "enum": [
        "plan_templates",
        "routine_templates",
        "daily_plan_items",
        "plan_adjustments",
        "timer_sessions",
        "timer_session_links",
        "training_logs",
        "body_metrics",
        "weather_logs",
        "media_assets",
        "feedback_summaries"
      ]
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "isoTimestamp": { "type": "string", "minLength": 10 },
    "trainingType": {
      "enum": [
        "strength", "easy_walk", "quality_walk", "indoor_cardio", "warmup",
        "cooldown", "recovery", "travel_strength", "seat_recovery", "stretch", "rest"
      ]
    },
    "completionStatus": {
      "enum": ["planned", "completed", "short_version", "stretch_only", "skipped", "rested", "modified_by_user"]
    },
    "timerCompletion": { "enum": ["in_progress", "completed", "stopped"] },
    "executionMode": {
      "enum": ["simple", "prepare_only", "alternating", "bilateral_hold", "bilateral_reps"]
    },
    "routineStep": {
      "type": "object",
      "required": ["stepId", "durationSeconds"],
      "properties": {
        "stepId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 160 },
        "phase": { "type": "string", "maxLength": 80 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 21600 },
        "dose": { "type": "string", "maxLength": 500 },
        "execution": {
          "type": "object",
          "properties": {
            "mode": { "$ref": "#/$defs/executionMode" },
            "prepareSeconds": { "type": "number", "minimum": 0, "maximum": 900 },
            "sideSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 21600 },
            "switchSeconds": { "type": "number", "minimum": 0, "maximum": 900 },
            "sides": { "type": "array", "items": { "type": "string", "maxLength": 32 }, "maxItems": 4 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "routineTemplate": {
      "type": "object",
      "required": ["id", "title", "trainingType", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "trainingType": { "$ref": "#/$defs/trainingType" },
        "scene": { "enum": ["home", "walk", "recovery", "travel"] },
        "estimatedMinutes": { "type": "number", "minimum": 0, "maximum": 1440 },
        "timerVisible": { "type": "boolean" },
        "needsTimer": { "type": "boolean" },
        "calendarVisible": { "type": "boolean" },
        "countsTowardTraining": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/routineStep" } }
      },
      "additionalProperties": true
    },
    "planTemplate": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "enum": ["draft", "active", "archived"] },
        "lifecycle": { "enum": ["draft", "published", "archived"] },
        "publishedAt": { "$ref": "#/$defs/isoTimestamp" },
        "immutable": { "type": "boolean" },
        "effectiveFrom": { "$ref": "#/$defs/isoDate" },
        "effectiveTo": { "anyOf": [{ "$ref": "#/$defs/isoDate" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "dailyPlanItem": {
      "type": "object",
      "required": ["id", "date", "trainingType", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "trainingType": { "$ref": "#/$defs/trainingType" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "estimatedMinutes": { "type": "number", "minimum": 0, "maximum": 1440 },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "needsTimer": { "type": "boolean" },
        "routineId": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/completionStatus" }
      },
      "additionalProperties": true
    },
    "planAdjustment": {
      "type": "object",
      "required": ["id", "date", "reason", "toSnapshot"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "reason": { "type": "string", "maxLength": 2000 },
        "toSnapshot": { "type": "object" },
        "adjustedAt": { "$ref": "#/$defs/isoTimestamp" }
      },
      "additionalProperties": true
    },
    "timerSession": {
      "type": "object",
      "required": ["id", "date", "routineId", "startedAt", "completion"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "routineId": { "$ref": "#/$defs/id" },
        "trainingType": { "$ref": "#/$defs/trainingType" },
        "startedAt": { "$ref": "#/$defs/isoTimestamp" },
        "endedAt": { "anyOf": [{ "$ref": "#/$defs/isoTimestamp" }, { "type": "null" }] },
        "actualSeconds": { "type": "number", "minimum": 0 },
        "elapsedSeconds": { "type": "number", "minimum": 0 },
        "pausedSeconds": { "type": "number", "minimum": 0 },
        "completion": { "$ref": "#/$defs/timerCompletion" }
      },
      "additionalProperties": true
    },
    "timerSessionLink": {
      "type": "object",
      "required": ["id", "timerSessionId", "date", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "timerSessionId": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "action": { "enum": ["linked", "converted", "ignored"] },
        "role": { "enum": ["warmup", "stretch", "cooldown", "main", "recovery", "note"] }
      },
      "additionalProperties": true
    },
    "trainingLog": {
      "type": "object",
      "required": ["id", "date", "type", "status", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "type": { "$ref": "#/$defs/trainingType" },
        "status": { "$ref": "#/$defs/completionStatus" },
        "source": { "enum": ["manual", "timer", "screenshot", "import", "coach_adjusted"] },
        "durationSec": { "type": "number", "minimum": 0 },
        "timerSessionId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": true
    },
    "bodyMetric": {
      "type": "object",
      "required": ["id", "date"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "weightKg": { "type": "number", "minimum": 0, "maximum": 500 },
        "waistCm": { "type": "number", "minimum": 0, "maximum": 500 },
        "bodyFatPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "muscleKg": { "type": "number", "minimum": 0, "maximum": 300 },
        "energy": { "type": "integer", "minimum": 1, "maximum": 5 },
        "fatigue": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "additionalProperties": true
    },
    "weatherLog": {
      "type": "object",
      "required": ["id", "date"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "temperatureC": { "type": "number", "minimum": -100, "maximum": 100 },
        "humidityPct": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "mediaAsset": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/isoTimestamp" },
        "contentType": { "type": "string", "maxLength": 120 }
      },
      "additionalProperties": true
    },
    "feedbackSummary": {
      "type": "object",
      "required": ["id", "period"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "period": {
          "type": "object",
          "required": ["from", "to"],
          "properties": { "from": { "$ref": "#/$defs/isoDate" }, "to": { "$ref": "#/$defs/isoDate" } }
        }
      },
      "additionalProperties": true
    },
    "recordEnvelope": {
      "type": "object",
      "required": ["contractVersion", "entity", "id", "revision", "deviceId", "createdAt", "updatedAt", "data"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "entity": { "$ref": "#/$defs/entity" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "deviceId": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/isoTimestamp" },
        "updatedAt": { "$ref": "#/$defs/isoTimestamp" },
        "deletedAt": { "anyOf": [{ "$ref": "#/$defs/isoTimestamp" }, { "type": "null" }] },
        "data": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "entity": { "const": "plan_templates" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/planTemplate" } } } },
        { "if": { "properties": { "entity": { "const": "routine_templates" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/routineTemplate" } } } },
        { "if": { "properties": { "entity": { "const": "daily_plan_items" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/dailyPlanItem" } } } },
        { "if": { "properties": { "entity": { "const": "plan_adjustments" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/planAdjustment" } } } },
        { "if": { "properties": { "entity": { "const": "timer_sessions" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/timerSession" } } } },
        { "if": { "properties": { "entity": { "const": "timer_session_links" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/timerSessionLink" } } } },
        { "if": { "properties": { "entity": { "const": "training_logs" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/trainingLog" } } } },
        { "if": { "properties": { "entity": { "const": "body_metrics" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/bodyMetric" } } } },
        { "if": { "properties": { "entity": { "const": "weather_logs" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/weatherLog" } } } },
        { "if": { "properties": { "entity": { "const": "media_assets" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/mediaAsset" } } } },
        { "if": { "properties": { "entity": { "const": "feedback_summaries" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/feedbackSummary" } } } }
      ],
      "additionalProperties": true
    },
    "coachPlanPatch": {
      "type": "object",
      "required": ["schema", "contractVersion", "effectiveFrom"],
      "properties": {
        "schema": { "const": "coach_plan_patch" },
        "contractVersion": { "const": "1.0" },
        "effectiveFrom": { "$ref": "#/$defs/isoDate" },
        "effectiveTo": { "$ref": "#/$defs/isoDate" },
        "routineTemplates": { "type": "array", "items": { "$ref": "#/$defs/routineTemplate" } },
        "dailyPlanItems": { "type": "array", "items": { "$ref": "#/$defs/dailyPlanItem" } },
        "planAdjustments": { "type": "array", "items": { "$ref": "#/$defs/planAdjustment" } }
      },
      "additionalProperties": true
    }
  }
}
