{
  "openapi": "3.1.0",
  "info": {
    "title": "Shenk Cloud API",
    "version": "2.0",
    "description": "Additive Contract v2 API. Contract v1 remains accepted during migration; omitted contractVersion is treated as 1.0."
  },
  "x-shenk-supported-contract-versions": ["1.0", "2.0"],
  "x-shenk-entity-owners": {
    "planning": ["plan_templates", "routine_templates", "daily_plan_items", "plan_adjustments", "plan_import_batches", "goal_sets", "coach_strategies"],
    "timer": ["timer_sessions"],
    "record": ["timer_session_links", "training_logs", "body_metrics", "status_checkins", "weather_logs", "feedback_summaries"],
    "ai_review": ["daily_reviews"],
    "planning_exchange": ["planning_runs", "coach_plan_patches"],
    "asset": ["media_assets"]
  },
  "servers": [{ "url": "https://shenke-cloud-db.sq-muyi.workers.dev/api" }],
  "paths": {
    "/health": {
      "get": {
        "responses": { "200": { "description": "Service and contract status" } }
      }
    },
    "/records/query": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordQuery" } } } },
        "responses": {
          "200": { "description": "Incremental record page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordQueryResponse" } } } },
          "400": { "$ref": "#/components/responses/ContractError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/records/upsert": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordUpsert" } } } },
        "responses": {
          "200": { "description": "Accepted records and explicit conflicts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordUpsertResponse" } } } },
          "400": { "$ref": "#/components/responses/ContractError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "description": "Batch or payload too large" }
        }
      }
    },
    "/timer-sessions": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "description": "Timer-role write endpoint. It never creates training_logs.",
        "responses": { "200": { "description": "Idempotent timer session result" }, "403": { "description": "Wrong role" } }
      }
    },
    "/sync-profiles/{profileId}": {
      "get": { "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Encrypted profile only" }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "put": { "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Encrypted profile saved" }, "400": { "description": "Invalid encrypted profile" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "RecordQuery": {
        "type": "object",
        "properties": {
          "contractVersion": { "const": "2.0" },
          "entities": { "type": "array", "items": { "$ref": "#/components/schemas/Entity" } },
          "since": { "type": ["string", "null"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
          "cursor": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      },
      "RecordEnvelope": {
        "type": "object",
        "required": ["entity", "id", "data"],
        "properties": {
          "contractVersion": { "const": "2.0" },
          "entity": { "$ref": "#/components/schemas/Entity" },
          "id": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 },
          "baseRevision": { "type": "integer", "minimum": 0 },
          "data": { "type": "object" }
        },
        "additionalProperties": true
      },
      "RecordUpsert": {
        "type": "object",
        "required": ["records"],
        "properties": {
          "contractVersion": { "const": "2.0" },
          "deviceId": { "type": "string" },
          "records": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/RecordEnvelope" } }
        }
      },
      "RecordQueryResponse": {
        "type": "object",
        "required": ["ok", "contractVersion", "serverTime", "records"],
        "properties": { "ok": { "const": true }, "contractVersion": { "const": "2.0" }, "serverTime": { "type": "string" }, "nextCursor": { "type": ["string", "null"] }, "records": { "type": "array", "items": { "$ref": "#/components/schemas/RecordEnvelope" } } }
      },
      "RecordUpsertResponse": {
        "type": "object",
        "required": ["ok", "contractVersion", "accepted", "conflicts"],
        "properties": { "ok": { "const": true }, "contractVersion": { "const": "2.0" }, "accepted": { "type": "array" }, "conflicts": { "type": "array" } }
      },
      "Entity": {
        "type": "string",
        "enum": [
          "plan_templates", "routine_templates", "daily_plan_items", "plan_adjustments",
          "timer_sessions", "timer_session_links", "training_logs", "body_metrics",
          "weather_logs", "media_assets", "feedback_summaries", "status_checkins",
          "daily_reviews", "plan_import_batches", "goal_sets", "coach_strategies",
          "planning_runs", "coach_plan_patches"
        ]
      },
      "Error": { "type": "object", "required": ["ok", "error"], "properties": { "ok": { "const": false }, "error": { "type": "string" } } }
    },
    "responses": {
      "Unauthorized": { "description": "Missing or invalid token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ContractError": { "description": "Unsupported contractVersion or invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
