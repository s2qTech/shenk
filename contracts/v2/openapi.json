{
  "openapi": "3.1.0",
  "info": {
    "title": "Shenk Cloud API",
    "version": "2.0",
    "description": "Additive Contract v2 API. Contract v1 remains accepted during migration; omitted contractVersion is treated as 1.0."
  },
  "x-shenk-supported-contract-versions": ["1.0", "2.0"],
  "x-shenk-entity-owners": {
    "planning": ["plan_templates", "routine_templates", "daily_plan_items", "plan_adjustments", "plan_import_batches", "goal_sets", "coach_strategies"],
    "timer": ["timer_sessions"],
    "record": ["timer_session_links", "training_logs", "body_metrics", "status_checkins", "weather_logs", "feedback_summaries"],
    "ai_review": ["daily_reviews"],
    "planning_exchange": ["planning_runs", "coach_plan_patches"],
    "asset": ["media_assets"]
  },
  "servers": [{ "url": "https://shenke-cloud-db.sq-muyi.workers.dev/api" }],
  "paths": {
    "/health": {
      "get": {
        "responses": { "200": { "description": "Service and contract status" } }
      }
    },
    "/records/query": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordQuery" } } } },
        "responses": {
          "200": { "description": "Incremental record page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordQueryResponse" } } } },
          "400": { "$ref": "#/components/responses/ContractError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/records/upsert": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordUpsert" } } } },
        "responses": {
          "200": { "description": "Accepted records and explicit conflicts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordUpsertResponse" } } } },
          "400": { "$ref": "#/components/responses/ContractError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "description": "Batch or payload too large" }
        }
      }
    },
    "/timer-sessions": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "description": "Timer-role write endpoint. It never creates training_logs.",
        "responses": { "200": { "description": "Idempotent timer session result" }, "403": { "description": "Wrong role" } }
      }
    },
    "/ai/connection-test": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "description": "Tests an OpenAI-compatible provider through the transient Worker proxy. Provider credentials are never persisted.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiProviderRequest" } } } },
        "responses": {
          "200": { "description": "Provider connection succeeded" },
          "400": { "$ref": "#/components/responses/ContractError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Client role cannot use the AI review proxy" }
        }
      }
    },
    "/ai/daily-review": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "description": "Submits one idempotent server-side daily-review job. A repeated RUNNING or SUCCEEDED jobId never calls the provider again.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DailyReviewRequest" } } } },
        "responses": {
          "200": { "description": "Terminal daily-review job state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DailyReviewResponse" } } } },
          "202": { "description": "The same job is already running", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DailyReviewResponse" } } } },
          "400": { "$ref": "#/components/responses/ContractError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Client role cannot use the AI review proxy" },
          "502": { "description": "Provider authentication or response failure" },
          "503": { "description": "Provider temporarily unavailable" }
        }
      }
    },
    "/ai/daily-review-jobs/{jobId}": {
      "get": {
        "security": [{ "bearerAuth": [] }],
        "description": "Reads the authoritative state of a previously submitted daily-review job without resubmitting provider work.",
        "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Current server job state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DailyReviewResponse" } } } },
          "404": { "description": "Unknown job id" }
        }
      }
    },
    "/sync-profiles/{profileId}": {
      "get": { "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Encrypted profile only" }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "put": { "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Encrypted profile saved" }, "400": { "description": "Invalid encrypted profile" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "RecordQuery": {
        "type": "object",
        "properties": {
          "contractVersion": { "const": "2.0" },
          "entities": { "type": "array", "items": { "$ref": "#/components/schemas/Entity" } },
          "since": { "type": ["string", "null"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
          "cursor": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      },
      "RecordEnvelope": {
        "type": "object",
        "required": ["entity", "id", "data"],
        "properties": {
          "contractVersion": { "const": "2.0" },
          "entity": { "$ref": "#/components/schemas/Entity" },
          "id": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 },
          "baseRevision": { "type": "integer", "minimum": 0 },
          "data": { "type": "object" }
        },
        "additionalProperties": true
      },
      "RecordUpsert": {
        "type": "object",
        "required": ["records"],
        "properties": {
          "contractVersion": { "const": "2.0" },
          "deviceId": { "type": "string" },
          "records": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/RecordEnvelope" } }
        }
      },
      "RecordQueryResponse": {
        "type": "object",
        "required": ["ok", "contractVersion", "serverTime", "records"],
        "properties": { "ok": { "const": true }, "contractVersion": { "const": "2.0" }, "serverTime": { "type": "string" }, "nextCursor": { "type": ["string", "null"] }, "records": { "type": "array", "items": { "$ref": "#/components/schemas/RecordEnvelope" } } }
      },
      "RecordUpsertResponse": {
        "type": "object",
        "required": ["ok", "contractVersion", "accepted", "conflicts"],
        "properties": { "ok": { "const": true }, "contractVersion": { "const": "2.0" }, "accepted": { "type": "array" }, "conflicts": { "type": "array" } }
      },
      "AiProvider": {
        "type": "object",
        "required": ["id", "baseUrl", "model", "apiKey"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "model": { "type": "string", "minLength": 1, "maxLength": 160 },
          "apiKey": { "type": "string", "minLength": 1, "writeOnly": true }
        },
        "additionalProperties": false
      },
      "AiProviderRequest": {
        "type": "object",
        "required": ["provider"],
        "properties": { "provider": { "$ref": "#/components/schemas/AiProvider" } },
        "additionalProperties": false
      },
      "DailyReviewSnapshot": {
        "type": "object",
        "required": ["schema", "contractVersion", "date", "missingCriticalFields", "records"],
        "properties": {
          "schema": { "const": "daily_review_snapshot" },
          "contractVersion": { "const": "2.0" },
          "date": { "type": "string", "format": "date" },
          "missingCriticalFields": { "type": "array", "items": { "type": "string" } },
          "records": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      },
      "DailyReviewRequest": {
        "type": "object",
        "required": ["jobId", "inputDigest", "provider", "snapshot"],
        "properties": {
          "jobId": { "type": "string", "minLength": 8, "maxLength": 160 },
          "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "retry": { "type": "boolean", "default": false },
          "provider": { "$ref": "#/components/schemas/AiProvider" },
          "snapshot": { "$ref": "#/components/schemas/DailyReviewSnapshot" }
        },
        "additionalProperties": false
      },
      "DailyReviewResponse": {
        "type": "object",
        "required": ["ok", "jobId", "state", "usage", "upstreamRequests"],
        "properties": {
          "ok": { "type": "boolean" },
          "jobId": { "type": "string" },
          "state": { "type": "string", "enum": ["RUNNING", "SUCCEEDED", "FAILED"] },
          "finishReason": { "type": ["string", "null"] },
          "upstreamRequests": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] },
          "updatedAt": { "type": "string", "format": "date-time" },
          "usage": {
            "type": "object",
            "required": ["promptTokens", "promptCacheHitTokens", "promptCacheMissTokens", "completionTokens", "reasoningTokens", "totalTokens"],
            "properties": {
              "promptTokens": { "type": "integer", "minimum": 0 },
              "promptCacheHitTokens": { "type": "integer", "minimum": 0 },
              "promptCacheMissTokens": { "type": "integer", "minimum": 0 },
              "completionTokens": { "type": "integer", "minimum": 0 },
              "reasoningTokens": { "type": "integer", "minimum": 0 },
              "totalTokens": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "review": {
            "type": ["object", "null"],
            "required": ["conclusion", "actions", "evidence", "cautions"],
            "properties": {
                "conclusion": { "type": "string", "minLength": 1, "maxLength": 120 },
                "assessment": { "type": "string", "maxLength": 600 },
                "actions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 300 } },
                "evidence": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 300 } },
                "cautions": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 300 } },
                "localSuggestion": {
                  "anyOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["date", "title", "trainingType"],
                      "properties": {
                        "date": { "type": "string", "format": "date" },
                        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "trainingType": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "estimatedMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 180 },
                        "reason": { "type": ["string", "null"], "maxLength": 300 }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "Entity": {
        "type": "string",
        "enum": [
          "plan_templates", "routine_templates", "daily_plan_items", "plan_adjustments",
          "timer_sessions", "timer_session_links", "training_logs", "body_metrics",
          "weather_logs", "media_assets", "feedback_summaries", "status_checkins",
          "daily_reviews", "plan_import_batches", "goal_sets", "coach_strategies",
          "planning_runs", "coach_plan_patches"
        ]
      },
      "Error": { "type": "object", "required": ["ok", "error"], "properties": { "ok": { "const": false }, "error": { "type": "string" } } }
    },
    "responses": {
      "Unauthorized": { "description": "Missing or invalid token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ContractError": { "description": "Unsupported contractVersion or invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
