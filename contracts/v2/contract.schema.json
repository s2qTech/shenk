{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2qtech.github.io/shenk/contracts/v2/contract.schema.json",
  "title": "Shenk shared data contract v2",
  "type": "object",
  "required": ["contractVersion"],
  "properties": {
    "contractVersion": { "const": "2.0" }
  },
  "$defs": {
    "entity": {
      "enum": [
        "plan_templates",
        "routine_templates",
        "daily_plan_items",
        "plan_adjustments",
        "timer_sessions",
        "timer_session_links",
        "training_logs",
        "body_metrics",
        "weather_logs",
        "media_assets",
        "feedback_summaries",
        "status_checkins",
        "daily_reviews",
        "plan_import_batches",
        "goal_sets",
        "coach_strategies"
      ]
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "isoTimestamp": { "type": "string", "minLength": 10 },
    "trainingType": {
      "enum": [
        "strength", "easy_walk", "quality_walk", "indoor_cardio", "warmup",
        "cooldown", "recovery", "travel_strength", "seat_recovery", "stretch", "rest"
      ]
    },
    "completionStatus": {
      "enum": ["planned", "completed", "short_version", "stretch_only", "skipped", "rested", "modified_by_user"]
    },
    "timerCompletion": { "enum": ["in_progress", "completed", "stopped"] },
    "executionMode": {
      "enum": ["simple", "prepare_only", "alternating", "bilateral_hold", "bilateral_reps"]
    },
    "routineStep": {
      "type": "object",
      "required": ["stepId", "durationSeconds"],
      "properties": {
        "stepId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 160 },
        "phase": { "type": "string", "maxLength": 80 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 21600 },
        "dose": { "type": "string", "maxLength": 500 },
        "execution": {
          "type": "object",
          "properties": {
            "mode": { "$ref": "#/$defs/executionMode" },
            "prepareSeconds": { "type": "number", "minimum": 0, "maximum": 900 },
            "sideSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 21600 },
            "switchSeconds": { "type": "number", "minimum": 0, "maximum": 900 },
            "sides": { "type": "array", "items": { "type": "string", "maxLength": 32 }, "maxItems": 4 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "routineTemplate": {
      "type": "object",
      "required": ["id", "title", "trainingType", "scene", "role", "lifecycle", "timerVisible", "calendarVisible", "countsTowardTraining", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "trainingType": { "$ref": "#/$defs/trainingType" },
        "scene": { "enum": ["home", "walk", "recovery", "travel"] },
        "role": { "enum": ["main", "warmup", "stretch", "cooldown", "recovery", "auxiliary"] },
        "lifecycle": { "enum": ["draft", "published", "archived"] },
        "estimatedMinutes": { "type": "number", "minimum": 0, "maximum": 1440 },
        "timerVisible": { "type": "boolean" },
        "needsTimer": { "type": "boolean" },
        "calendarVisible": { "type": "boolean" },
        "countsTowardTraining": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/routineStep" } },
        "publishedAt": { "$ref": "#/$defs/isoTimestamp" },
        "immutable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "planTemplate": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "enum": ["draft", "active", "archived"] },
        "lifecycle": { "enum": ["draft", "published", "archived"] },
        "publishedAt": { "$ref": "#/$defs/isoTimestamp" },
        "immutable": { "type": "boolean" },
        "effectiveFrom": { "$ref": "#/$defs/isoDate" },
        "effectiveTo": { "anyOf": [{ "$ref": "#/$defs/isoDate" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "dailyPlanItem": {
      "type": "object",
      "required": ["id", "date", "trainingType", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "trainingType": { "$ref": "#/$defs/trainingType" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "estimatedMinutes": { "type": "number", "minimum": 0, "maximum": 1440 },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "needsTimer": { "type": "boolean" },
        "routineId": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/completionStatus" }
      },
      "additionalProperties": true
    },
    "planAdjustment": {
      "type": "object",
      "required": ["id", "date", "reason", "toSnapshot"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "reason": { "type": "string", "maxLength": 2000 },
        "toSnapshot": { "type": "object" },
        "adjustedAt": { "$ref": "#/$defs/isoTimestamp" }
      },
      "additionalProperties": true
    },
    "timerSession": {
      "type": "object",
      "required": ["id", "date", "routineId", "routineVersion", "routineDigest", "startedAt", "completion", "calendarVisible", "countsTowardTraining", "activeSeconds", "elapsedSeconds", "pausedSeconds", "devicePlatform", "idempotencyKey"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "routineId": { "$ref": "#/$defs/id" },
        "routineVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "routineDigest": { "type": "string", "minLength": 1, "maxLength": 160 },
        "routineSnapshot": { "type": "object" },
        "dailyPlanItemId": { "$ref": "#/$defs/id" },
        "planTemplateId": { "$ref": "#/$defs/id" },
        "trainingType": { "$ref": "#/$defs/trainingType" },
        "startedAt": { "$ref": "#/$defs/isoTimestamp" },
        "endedAt": { "anyOf": [{ "$ref": "#/$defs/isoTimestamp" }, { "type": "null" }] },
        "actualSeconds": { "type": "number", "minimum": 0 },
        "activeSeconds": { "type": "number", "minimum": 0 },
        "elapsedSeconds": { "type": "number", "minimum": 0 },
        "pausedSeconds": { "type": "number", "minimum": 0 },
        "completion": { "$ref": "#/$defs/timerCompletion" },
        "calendarVisible": { "type": "boolean" },
        "countsTowardTraining": { "type": "boolean" },
        "interruptionReason": { "type": ["string", "null"], "maxLength": 500 },
        "stepResults": { "type": "array", "items": { "type": "object" } },
        "devicePlatform": { "enum": ["web", "android"] },
        "idempotencyKey": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": true
    },
    "timerSessionLink": {
      "type": "object",
      "required": ["id", "timerSessionId", "date", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "timerSessionId": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "action": { "enum": ["linked", "converted", "ignored"] },
        "role": { "enum": ["warmup", "stretch", "cooldown", "main", "recovery", "note"] }
      },
      "additionalProperties": true
    },
    "trainingLog": {
      "type": "object",
      "required": ["id", "date", "type", "status", "source", "calendarVisible", "countsTowardTraining"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "type": { "$ref": "#/$defs/trainingType" },
        "status": { "$ref": "#/$defs/completionStatus" },
        "source": { "enum": ["manual", "timer", "native_timer", "health_connect", "xiaomi_import", "wearable", "screenshot", "import", "coach_adjusted", "legacy"] },
        "durationSec": { "type": "number", "minimum": 0 },
        "timerSessionId": { "$ref": "#/$defs/id" },
        "timerSessionIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "startedAt": { "$ref": "#/$defs/isoTimestamp" },
        "endedAt": { "anyOf": [{ "$ref": "#/$defs/isoTimestamp" }, { "type": "null" }] },
        "distanceKm": { "type": "number", "minimum": 0 },
        "averageHeartRate": { "type": "number", "minimum": 0, "maximum": 300 },
        "perceivedEffort": { "type": "integer", "minimum": 1, "maximum": 10 },
        "subjectiveResult": { "type": "string", "maxLength": 1000 },
        "notes": { "type": "string", "maxLength": 4000 },
        "sourceRecordId": { "type": ["string", "null"], "maxLength": 160 },
        "calendarVisible": { "type": "boolean" },
        "countsTowardTraining": { "type": "boolean" },
        "rawSource": { "type": "object" }
      },
      "additionalProperties": true
    },
    "bodyMetric": {
      "type": "object",
      "required": ["id", "date", "observedAt", "context", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "observedAt": { "$ref": "#/$defs/isoTimestamp" },
        "context": { "enum": ["morning", "other"] },
        "source": { "enum": ["manual", "health_connect", "xiaomi_import", "scale_import", "legacy"] },
        "sourceRecordId": { "type": ["string", "null"], "maxLength": 160 },
        "weightKg": { "type": "number", "minimum": 0, "maximum": 500 },
        "waistCm": { "type": "number", "minimum": 0, "maximum": 500 },
        "bodyFatPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "muscleKg": { "type": "number", "minimum": 0, "maximum": 300 },
        "energy": { "type": "integer", "minimum": 1, "maximum": 5 },
        "fatigue": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "additionalProperties": true
    },
    "statusCheckin": {
      "type": "object",
      "required": ["id", "date", "kind", "observedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "kind": { "enum": ["morning", "pre_workout"] },
        "observedAt": { "$ref": "#/$defs/isoTimestamp" },
        "baseCheckinId": { "type": ["string", "null"], "maxLength": 160 },
        "sleepDurationMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "deepSleepMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "sleepQuality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "energy": { "type": "integer", "minimum": 1, "maximum": 5 },
        "fatigue": { "type": "integer", "minimum": 0, "maximum": 5 },
        "workPressure": { "type": "integer", "minimum": 0, "maximum": 5 },
        "pain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["region", "severity"],
            "properties": {
              "region": { "enum": ["neck_shoulder", "wrist", "lower_back", "hip_glute", "thigh_knee", "calf_ankle", "other"] },
              "severity": { "type": "integer", "minimum": 0, "maximum": 5 },
              "side": { "enum": ["left", "right", "bilateral", "unspecified"] }
            },
            "additionalProperties": true
          }
        },
        "note": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": true
    },
    "dailyReview": {
      "type": "object",
      "required": ["id", "date", "version", "status", "conclusion", "inputDigest", "provider", "model", "generatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["generated", "invalidated", "failed"] },
        "conclusion": { "type": "string", "maxLength": 4000 },
        "evidence": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
        "cautions": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
        "inputDigest": { "type": "string", "minLength": 1, "maxLength": 160 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "generatedAt": { "$ref": "#/$defs/isoTimestamp" }
      },
      "additionalProperties": true
    },
    "planImportBatch": {
      "type": "object",
      "required": ["id", "patchId", "patchSchema", "receivedAt", "status", "affectedEntityIds", "counts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "patchId": { "$ref": "#/$defs/id" },
        "patchSchema": { "const": "coach_plan_patch" },
        "patchVersion": { "type": "string", "maxLength": 40 },
        "receivedAt": { "$ref": "#/$defs/isoTimestamp" },
        "appliedAt": { "anyOf": [{ "$ref": "#/$defs/isoTimestamp" }, { "type": "null" }] },
        "generatedBy": { "type": "string", "maxLength": 160 },
        "reason": { "type": "string", "maxLength": 2000 },
        "affectedEntityIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "counts": {
          "type": "object",
          "required": ["added", "updated", "deleted"],
          "properties": {
            "added": { "type": "integer", "minimum": 0 },
            "updated": { "type": "integer", "minimum": 0 },
            "deleted": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "beforeSnapshots": { "type": "object" },
        "status": { "enum": ["previewed", "applied", "undone", "rejected"] }
      },
      "additionalProperties": true
    },
    "goalSet": {
      "type": "object",
      "required": ["id", "version", "lifecycle", "effectiveFrom", "goals"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "lifecycle": { "enum": ["draft", "published", "archived"] },
        "effectiveFrom": { "$ref": "#/$defs/isoDate" },
        "effectiveTo": { "anyOf": [{ "$ref": "#/$defs/isoDate" }, { "type": "null" }] },
        "goals": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "rationale": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": true
    },
    "coachStrategy": {
      "type": "object",
      "required": ["id", "version", "lifecycle", "effectiveFrom", "boundaries"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "lifecycle": { "enum": ["draft", "published", "archived"] },
        "effectiveFrom": { "$ref": "#/$defs/isoDate" },
        "effectiveTo": { "anyOf": [{ "$ref": "#/$defs/isoDate" }, { "type": "null" }] },
        "boundaries": { "type": "object" },
        "rationale": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": true
    },
    "weatherLog": {
      "type": "object",
      "required": ["id", "date"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDate" },
        "temperatureC": { "type": "number", "minimum": -100, "maximum": 100 },
        "humidityPct": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "mediaAsset": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/isoTimestamp" },
        "contentType": { "type": "string", "maxLength": 120 }
      },
      "additionalProperties": true
    },
    "feedbackSummary": {
      "type": "object",
      "required": ["id", "period"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "period": {
          "type": "object",
          "required": ["from", "to"],
          "properties": { "from": { "$ref": "#/$defs/isoDate" }, "to": { "$ref": "#/$defs/isoDate" } }
        }
      },
      "additionalProperties": true
    },
    "recordEnvelope": {
      "type": "object",
      "required": ["contractVersion", "entity", "id", "revision", "deviceId", "createdAt", "updatedAt", "data"],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "entity": { "$ref": "#/$defs/entity" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "deviceId": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/isoTimestamp" },
        "updatedAt": { "$ref": "#/$defs/isoTimestamp" },
        "deletedAt": { "anyOf": [{ "$ref": "#/$defs/isoTimestamp" }, { "type": "null" }] },
        "data": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "entity": { "const": "plan_templates" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/planTemplate" } } } },
        { "if": { "properties": { "entity": { "const": "routine_templates" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/routineTemplate" } } } },
        { "if": { "properties": { "entity": { "const": "daily_plan_items" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/dailyPlanItem" } } } },
        { "if": { "properties": { "entity": { "const": "plan_adjustments" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/planAdjustment" } } } },
        { "if": { "properties": { "entity": { "const": "timer_sessions" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/timerSession" } } } },
        { "if": { "properties": { "entity": { "const": "timer_session_links" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/timerSessionLink" } } } },
        { "if": { "properties": { "entity": { "const": "training_logs" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/trainingLog" } } } },
        { "if": { "properties": { "entity": { "const": "body_metrics" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/bodyMetric" } } } },
        { "if": { "properties": { "entity": { "const": "weather_logs" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/weatherLog" } } } },
        { "if": { "properties": { "entity": { "const": "media_assets" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/mediaAsset" } } } },
        { "if": { "properties": { "entity": { "const": "feedback_summaries" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/feedbackSummary" } } } },
        { "if": { "properties": { "entity": { "const": "status_checkins" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/statusCheckin" } } } },
        { "if": { "properties": { "entity": { "const": "daily_reviews" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/dailyReview" } } } },
        { "if": { "properties": { "entity": { "const": "plan_import_batches" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/planImportBatch" } } } },
        { "if": { "properties": { "entity": { "const": "goal_sets" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/goalSet" } } } },
        { "if": { "properties": { "entity": { "const": "coach_strategies" } }, "required": ["entity"] }, "then": { "properties": { "data": { "$ref": "#/$defs/coachStrategy" } } } }
      ],
      "additionalProperties": true
    },
    "coachPlanPatch": {
      "type": "object",
      "required": ["schema", "contractVersion", "effectiveFrom"],
      "properties": {
        "schema": { "const": "coach_plan_patch" },
        "contractVersion": { "const": "2.0" },
        "effectiveFrom": { "$ref": "#/$defs/isoDate" },
        "effectiveTo": { "$ref": "#/$defs/isoDate" },
        "replaceMode": { "type": "boolean", "default": false },
        "planTemplates": { "type": "array", "items": { "$ref": "#/$defs/planTemplate" } },
        "routineTemplates": { "type": "array", "items": { "$ref": "#/$defs/routineTemplate" } },
        "dailyPlanItems": { "type": "array", "items": { "$ref": "#/$defs/dailyPlanItem" } },
        "planAdjustments": { "type": "array", "items": { "$ref": "#/$defs/planAdjustment" } }
      },
      "additionalProperties": true
    }
  }
}
