  "requiredInvariants": [
    {
      "id": "G-DATA-001",
      "rule": "All user business writes are local-first and transactionally enqueue an outbox operation."
    },
    {
      "id": "G-DATA-002",
      "rule": "Dirty local records are never silently overwritten by cloud pulls."
    },
    {
      "id": "G-PLAN-001",
      "rule": "Formal actual record outranks effective formal plan, which outranks local fallback suggestion."
    },
    {
      "id": "G-PLAN-002",
      "rule": "Missing patch fields and empty arrays are no-op; deletion must be explicit."
    },
    {
      "id": "G-ROUTINE-001",
      "rule": "Routine scene and role are explicit authoritative fields and are never inferred from title, type, id, or steps."
    },
    {
      "id": "G-TIMER-001",
      "rule": "Timer sessions are immutable execution facts and formal training logs require user confirmation."
    },
    {
      "id": "G-AI-001",
      "rule": "Daily compatible AI cannot mutate formal plans, adjustments, goals, strategies, or routines."
    },
    {
      "id": "G-SEC-001",
      "rule": "Secrets and real health data never enter source, docs, URLs, logs, fixtures, Git, or normal backups."
    },
    {
      "id": "G-ANDROID-001",
      "rule": "Production Android uses Kotlin and Jetpack Compose; Capacitor remains a frozen prototype."
    },
    {
      "id": "G-DELETE-001",
      "rule": "Deleted items disappear from normal UI immediately; tombstones remain internal to synchronization."
    }
  ],
  "requiresExplicitUserApproval": [
    "destructive_or_physical_data_deletion",
    "bulk_reclassification_or_metadata_inference",
    "replace_mode_import",
    "entity_ownership_change",
